# ---- Required ----
# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=paste_telegram_token_here
# Vercel/webhook mode: random string Telegram sends with each update (any long random text)
TELEGRAM_WEBHOOK_SECRET=
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_gemini_key_here
# Any Gemini text model your key can use (check_setup.py lists them if this one fails)
GEMINI_MODEL=gemini-3.6-flash
# Optional: stronger model for the fact/voice reviewer (e.g. gemini-3.1-pro-preview). Empty = same as above.
GEMINI_REVIEW_MODEL=gemini-3.1-pro-preview
# Used automatically if the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Meera's Telegram chat ID (comma-separate for more people). Leave empty at first:
# start the bot, send /start, and it will tell you the ID to put here.
ALLOWED_CHAT_IDS=

# ---- Current context (Google News RSS, no key needed) ----
NEWS_ENABLED=true
NEWS_REGION=IN
NEWS_MAX_ITEMS=8
NEWS_MAX_AGE_DAYS=30

# ---- Optional: Phase 2 auto-publish to LinkedIn ----
# Leave empty and Approve simply returns the final text to copy-paste.
LINKEDIN_ACCESS_TOKEN=
# Optional - auto-detected from the token if empty (e.g. urn:li:person:AbC123)
LINKEDIN_AUTHOR_URN=
# LinkedIn API version, YYYYMM. Versions expire after ~12 months - bump if you get a version error.
LINKEDIN_API_VERSION=202608

# ---- Quality gate ----
# Notes must score at least this out of 10 before a post is drafted
NOTES_MIN_SCORE=7
